{
  "name": "@bleephub/web",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": ["core"],
  "scripts": {
    "dev": "vite",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "rm -f core/tsconfig.build.tsbuildinfo && bun run --cwd core build && tsc --noEmit && tsc -p core/tsconfig.json --noEmit && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@bleephub/ui-core": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "libsodium-wrappers": "^0.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@octokit/auth-app": "^8.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "jscpd": "5.0.14",
    "knip": "6.31.0",
    "octokit": "^5.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@asamuzakjp/dom-selector": "8.3.0",
    "esbuild": "0.28.1",
    "tinyrainbow": "3.1.0"
  }
}
