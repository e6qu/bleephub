# Google's Docker Hub mirror, pinned to the digest Docker Hub serves: Docker
# Hub limits anonymous pulls per address, and the shared CI runners exhaust it.
FROM mirror.gcr.io/oven/bun:1.4.3-alpine@sha256:629e17411f1f129dbec3af78d5af9c9f2a937435c80349437206c6b0b7422373 AS ui-builder
ARG BLEEPHUB_VERSION=development
ARG BLEEPHUB_PUBLISHED_AT=not-yet-published
ENV VITE_BLEEPHUB_VERSION=$BLEEPHUB_VERSION \
    VITE_BLEEPHUB_PUBLISHED_AT=$BLEEPHUB_PUBLISHED_AT
WORKDIR /src/web
COPY web/package.json web/bun.lock web/tsconfig.base.json ./
COPY web/core ./core
COPY web/src ./src
COPY web/public ./public
COPY web/index.html web/knip.ts web/tsconfig.json web/vite.config.ts ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile && bun run build

# Amazon ECR Public's copy of Docker's official image, pinned to the digest
# Docker Hub serves: Docker Hub limits anonymous pulls per address, and the
# shared CI runners exhaust it.
FROM public.ecr.aws/docker/library/golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673 AS builder
# The official golang images pin GOTOOLCHAIN=local; re-enable auto so the
# image builds with whatever toolchain go.mod requires.
ENV GOTOOLCHAIN=auto
ARG BLEEPHUB_VERSION=development
ARG BLEEPHUB_COMMIT=none
ARG BLEEPHUB_PUBLISHED_AT=not-yet-published
WORKDIR /src
COPY . .
COPY --from=ui-builder /src/web/dist/ ./internal/server/dist/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${BLEEPHUB_VERSION} -X main.commit=${BLEEPHUB_COMMIT} -X main.publishedAt=${BLEEPHUB_PUBLISHED_AT}" -o /bleephub ./cmd/bleephub && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${BLEEPHUB_VERSION} -X main.commit=${BLEEPHUB_COMMIT} -X main.publishedAt=${BLEEPHUB_PUBLISHED_AT}" -o /bleephub-ssh-gateway ./ssh-gateway && \
    mkdir /build-info && \
    BLEEPHUB_VERSION="${BLEEPHUB_VERSION}" BLEEPHUB_COMMIT="${BLEEPHUB_COMMIT}" BLEEPHUB_PUBLISHED_AT="${BLEEPHUB_PUBLISHED_AT}" \
        scripts/write-build-info.sh /bleephub /build-info/bleephub.build-info.txt && \
    BLEEPHUB_VERSION="${BLEEPHUB_VERSION}" BLEEPHUB_COMMIT="${BLEEPHUB_COMMIT}" BLEEPHUB_PUBLISHED_AT="${BLEEPHUB_PUBLISHED_AT}" \
        scripts/write-build-info.sh /bleephub-ssh-gateway /build-info/bleephub-ssh-gateway.build-info.txt

# Amazon ECR Public's copy of Docker's official image, pinned to the digest
# Docker Hub serves: Docker Hub limits anonymous pulls per address, and the
# shared CI runners exhaust it.
FROM public.ecr.aws/docker/library/golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS go-toolchain

# Amazon ECR Public's copy of Docker's official image, pinned to the digest
# Docker Hub serves: Docker Hub limits anonymous pulls per address, and the
# shared CI runners exhaust it.
FROM public.ecr.aws/docker/library/ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb AS dqlite-builder
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
ARG BLEEPHUB_VERSION=development
ARG BLEEPHUB_COMMIT=none
ARG BLEEPHUB_PUBLISHED_AT=not-yet-published
# A build stage only: its packages never reach the image, so it installs what
# the build needs without upgrading the rest.
RUN apt_transaction() { rm -rf /var/lib/apt/lists/*; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; }; \
    retry_apt_transaction() { apt_transaction "$@" || apt_transaction "$@"; }; \
    retry_apt_transaction ca-certificates build-essential libdqlite-dev=1.18.4-1 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
# go.mod replaces the gitstore and gcsclient libraries with ./gitstore and
# ./gcsclient, and the module graph cannot be loaded without each replacement's
# own go.mod.
COPY gitstore/go.mod gitstore/go.sum ./gitstore/
COPY gcsclient/go.mod gcsclient/go.sum ./gcsclient/
RUN go mod download
COPY dqlite-node ./dqlite-node
COPY internal/dqliteaddr ./internal/dqliteaddr
COPY scripts/write-build-info.sh ./scripts/write-build-info.sh
RUN CGO_ENABLED=1 go build -trimpath -tags 'nosqlite3,dqlite' -ldflags="-s -w -X main.version=${BLEEPHUB_VERSION} -X main.commit=${BLEEPHUB_COMMIT} -X main.publishedAt=${BLEEPHUB_PUBLISHED_AT}" -o /bleephub-dqlite-node ./dqlite-node && \
    mkdir /build-info && \
    BLEEPHUB_VERSION="${BLEEPHUB_VERSION}" BLEEPHUB_COMMIT="${BLEEPHUB_COMMIT}" BLEEPHUB_PUBLISHED_AT="${BLEEPHUB_PUBLISHED_AT}" \
        scripts/write-build-info.sh /bleephub-dqlite-node /build-info/bleephub-dqlite-node.build-info.txt

# Amazon ECR Public's copy of Docker's official image, pinned to the digest
# Docker Hub serves: Docker Hub limits anonymous pulls per address, and the
# shared CI runners exhaust it.
FROM public.ecr.aws/docker/library/ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb
# Jekyll and Sass read source files as the process's default external encoding;
# without a UTF-8 locale Ruby defaults to US-ASCII and any UTF-8 byte in a theme
# or a site's content (e.g. jekyll-theme-primer's SCSS) aborts the build.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
COPY docker/pages-gems/Gemfile docker/pages-gems/pinned-gems.sha256 docker/pages-gems/github-pages-config.yml /opt/bleephub-pages/
WORKDIR /opt/bleephub-pages/vendor/cache
# Every gem in the github-pages closure is fetched by exact version, checked
# against its recorded SHA-256, and only then installed; --local keeps bundler
# from reaching past the verified cache for anything the pins missed.
RUN apt_transaction() { rm -rf /var/lib/apt/lists/*; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; }; \
    retry_apt_transaction() { apt_transaction "$@" || apt_transaction "$@"; }; \
    retry_apt_transaction ca-certificates curl && \
    retry_apt_transaction ruby-full ruby-bundler build-essential git libdqlite0=1.18.4-1 libssl-dev pkg-config && \
    mkdir -p /opt/bleephub-pages/vendor/cache && \
    while read -r digest gem; do \
        curl --fail --location --silent --show-error \
            --retry 5 --retry-all-errors --retry-delay 1 --connect-timeout 30 \
            --remote-name "https://rubygems.org/downloads/$gem" || exit 1; \
    done < /opt/bleephub-pages/pinned-gems.sha256 && \
    sha256sum --check --strict /opt/bleephub-pages/pinned-gems.sha256 && \
    BUNDLE_GEMFILE=/opt/bleephub-pages/Gemfile bundle install --local && \
    apt-get purge -y --auto-remove build-essential curl libssl-dev pkg-config && \
    rm -rf /var/lib/apt/lists/* /root/.bundle/cache /usr/local/bundle/cache /opt/bleephub-pages/vendor/cache
# Security updates land in their own late layer, keyed on the Ubuntu archive
# state (scripts/ubuntu-archive-state.sh): a new value reruns only this upgrade,
# while the package, Ruby and gem layer above stays cached.
ARG UBUNTU_ARCHIVE_STATE=unset
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /bleephub /usr/local/bin/bleephub
COPY --from=builder /bleephub-ssh-gateway /usr/local/bin/bleephub-ssh-gateway
COPY --from=dqlite-builder /bleephub-dqlite-node /usr/local/bin/bleephub-dqlite-node
COPY pages-jekyll /usr/local/bin/bleephub-pages-jekyll
# The terms of what these binaries contain, where someone holding only the image
# can read them: bleephub's own licence, and the licence and attribution notices
# of every module linked into it, which those licences require to accompany it.
COPY LICENSE THIRD-PARTY-NOTICES.md THIRD-PARTY-LICENSES.txt /usr/share/doc/bleephub/
# And what each binary was built from — release, commit, its own digest, every
# module linked in with its version and checksum — read back out of the binary by
# the toolchain that built it. The binaries are as they were; this sits beside them.
COPY --from=builder /build-info/ /usr/share/doc/bleephub/
COPY --from=dqlite-builder /build-info/ /usr/share/doc/bleephub/
# Ubuntu ships an unowned ACME test-server binary in this base image. Bleephub
# never invokes it, and retaining a network daemon with its own Go dependency
# graph would expand both the runtime surface and vulnerability inventory.
RUN rm -f /usr/bin/pebble && \
    chmod 0755 /usr/local/bin/bleephub-pages-jekyll && \
    useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin bleephub
WORKDIR /
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
    CMD bash -c "exec 3<>/dev/tcp/127.0.0.1/5555 && printf 'GET /health HTTP/1.0\r\n\r\n' >&3 && grep -q '^HTTP/1.[01] 200' <&3"
ENTRYPOINT ["bleephub"]
