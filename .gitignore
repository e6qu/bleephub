.build/
.local/
.terraform/
bleephub-server
bleephub-dqlite-node
web/node_modules/
web/core/node_modules/
web/dist/
web/core/dist/
# The embedded UI (internal/server/dist) is a generated Vite artifact, built by
# the release image and `make build`, not committed. Keep only .gitkeep so the
# directory exists and `//go:embed all:dist` still compiles on a fresh checkout.
internal/server/dist/*
!internal/server/dist/.gitkeep
web/.auth/
web/test-results/
web/playwright-report/
*.tsbuildinfo

# Terraform state holds the SSH host private key and the admin token. The
# module keeps it in an encrypted remote backend, but a local `terraform apply`
# or a `-backend=false` run still writes it here, and a plan file carries the
# same values — none of it must ever be committable.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
*.auto.tfvars
!terraform.tfvars.example
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Private key material of any kind.
*.pem
*.key
id_rsa
id_ed25519

# Conformance harness scratch space and generated scoreboard. The ratchet floor
# (test/conformance/floor.json) IS committed; the report it is checked against
# is a build artifact.
test/conformance/.work/
test/conformance/.lock/
test/conformance/report/

# Test and coverage output.
coverage.out
coverage.html
web/coverage/
*.test
__pycache__/
*.py[cod]

# Local credentials.
.env
.env.*

# macOS.
.DS_Store

# Compiled Lambda handlers left behind by a bare `go build ./...` in the
# module directory. These are build output, not source.
terraform/wake/bleephub-ecs-wake
terraform/startup/bleephub-startup
