FROM golang:1.26.7@sha256:45a5f7a810238aabcbad211d70b9ae082022d96f7c7259e94041ad1b933575ac AS builder
# Re-enable toolchain auto-download (the golang image pins GOTOOLCHAIN=local) so
# this 1.26.5 image builds with the go1.26.6 toolchain go.mod requires.
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -tags noui -o /out/bleephub ./cmd/bleephub

FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates jq git openssl zip && rm -rf /var/lib/apt/lists/*
# gh is pinned to the exact version the compatibility docs verify
# (docs/BLEEPHUB_GH_CLI.md: "verified on 2.92.0"). The cli.github.com apt
# repository only ever carries whatever release is current, so installing `gh`
# from it floats the harness onto an unverified version. Instead the release
# .deb is fetched by version and checked byte-for-byte against the digest
# published in the release's gh_<version>_checksums.txt before it is installed —
# a stronger pin than the apt signer keyring, which authenticates the publisher
# but not the version. apt resolves the .deb's runtime dependencies from Ubuntu.
ARG GH_VERSION=2.92.0
ARG GH_SHA256_AMD64=8f8212b1a9cec261a8839e0893168f50d3fc70f095da257feef4229234cefdf8
ARG GH_SHA256_ARM64=34d620b7c884774ed86236541535170889fda0b99aafbdab8b69c7d458b5ca6b
RUN arch="$(dpkg --print-architecture)" && \
    case "$arch" in \
        amd64) gh_sha256="$GH_SHA256_AMD64" ;; \
        arm64) gh_sha256="$GH_SHA256_ARM64" ;; \
        *) echo "Unsupported architecture for pinned gh: $arch" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/gh.deb \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.deb" && \
    printf '%s  %s\n' "$gh_sha256" /tmp/gh.deb | sha256sum --check --strict - && \
    apt-get update && apt-get install -y --no-install-recommends /tmp/gh.deb && \
    rm -f /tmp/gh.deb && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/bleephub /usr/local/bin/
COPY test/run-gh-test.sh /test/run-gh-test.sh
RUN chmod +x /test/run-gh-test.sh
WORKDIR /test
ENTRYPOINT ["/test/run-gh-test.sh"]
