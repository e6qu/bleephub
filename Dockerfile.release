FROM oven/bun:1.4.1-alpine@sha256:2ef545220f7a886f22fcb3f2309bbd6bcf1c0aa04b7d79c31765c7aa4a13aac1 AS ui-builder
ARG BLEEPHUB_VERSION=development
ARG BLEEPHUB_PUBLISHED_AT=not-yet-published
ENV VITE_BLEEPHUB_VERSION=$BLEEPHUB_VERSION \
    VITE_BLEEPHUB_PUBLISHED_AT=$BLEEPHUB_PUBLISHED_AT
WORKDIR /src/web
COPY web/package.json web/bun.lock web/tsconfig.base.json ./
COPY web/core ./core
COPY web/src ./src
COPY web/public ./public
COPY web/index.html web/knip.ts web/tsconfig.json web/vite.config.ts ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile && bun run build

FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder
# The official golang images pin GOTOOLCHAIN=local; re-enable auto so this
# 1.26.5 image downloads and builds with the go1.26.6 toolchain go.mod requires
# (patched stdlib — CVE-2026-39821 / -46600). The base image stays 1.26.5
# because the published golang:1.26.6 images are still inside the 24h supply-
# chain quarantine.
ENV GOTOOLCHAIN=auto
ARG BLEEPHUB_VERSION=development
ARG BLEEPHUB_COMMIT=none
ARG BLEEPHUB_PUBLISHED_AT=not-yet-published
WORKDIR /src
COPY . .
COPY --from=ui-builder /src/web/dist/ ./internal/server/dist/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${BLEEPHUB_VERSION} -X main.commit=${BLEEPHUB_COMMIT} -X main.publishedAt=${BLEEPHUB_PUBLISHED_AT}" -o /bleephub ./cmd/bleephub && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${BLEEPHUB_VERSION} -X main.commit=${BLEEPHUB_COMMIT} -X main.publishedAt=${BLEEPHUB_PUBLISHED_AT}" -o /bleephub-ssh-gateway ./ssh-gateway

FROM golang:1.27.1-bookworm@sha256:648f440f42a0958804efb24df176f806f9d353b41f1c0627f666428e40310f6b AS go-toolchain

FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb AS dqlite-builder
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
ARG BLEEPHUB_VERSION=development
ARG BLEEPHUB_COMMIT=none
ARG BLEEPHUB_PUBLISHED_AT=not-yet-published
RUN apt_transaction() { rm -rf /var/lib/apt/lists/*; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; }; \
    retry_apt_transaction() { apt_transaction "$@" || apt_transaction "$@"; }; \
    retry_apt_transaction ca-certificates build-essential libdqlite-dev=1.18.4-1 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY dqlite-node ./dqlite-node
COPY internal/dqliteaddr ./internal/dqliteaddr
RUN CGO_ENABLED=1 go build -trimpath -tags 'nosqlite3,dqlite' -ldflags="-s -w -X main.version=${BLEEPHUB_VERSION} -X main.commit=${BLEEPHUB_COMMIT} -X main.publishedAt=${BLEEPHUB_PUBLISHED_AT}" -o /bleephub-dqlite-node ./dqlite-node

FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb
COPY docker/pages-gems/Gemfile docker/pages-gems/pinned-gems.sha256 /opt/bleephub-pages/
WORKDIR /opt/bleephub-pages/vendor/cache
# Every gem in the github-pages closure is fetched by exact version, checked
# against its recorded SHA-256, and only then installed; --local keeps bundler
# from reaching past the verified cache for anything the pins missed.
RUN apt_transaction() { rm -rf /var/lib/apt/lists/*; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; }; \
    retry_apt_transaction() { apt_transaction "$@" || apt_transaction "$@"; }; \
    retry_apt_transaction ca-certificates curl && \
    retry_apt_transaction ruby-full ruby-bundler build-essential git libdqlite0=1.18.4-1 && \
    mkdir -p /opt/bleephub-pages/vendor/cache && \
    while read -r digest gem; do \
        curl --fail --location --silent --show-error \
            --retry 5 --retry-all-errors --retry-delay 1 --connect-timeout 30 \
            --remote-name "https://rubygems.org/downloads/$gem" || exit 1; \
    done < /opt/bleephub-pages/pinned-gems.sha256 && \
    sha256sum --check --strict /opt/bleephub-pages/pinned-gems.sha256 && \
    BUNDLE_GEMFILE=/opt/bleephub-pages/Gemfile bundle install --local && \
    apt-get purge -y --auto-remove build-essential curl && \
    rm -rf /var/lib/apt/lists/* /root/.bundle/cache /usr/local/bundle/cache /opt/bleephub-pages/vendor/cache
COPY --from=builder /bleephub /usr/local/bin/bleephub
COPY --from=builder /bleephub-ssh-gateway /usr/local/bin/bleephub-ssh-gateway
COPY --from=dqlite-builder /bleephub-dqlite-node /usr/local/bin/bleephub-dqlite-node
COPY pages-jekyll /usr/local/bin/bleephub-pages-jekyll
# Ubuntu ships an unowned ACME test-server binary in this base image. Bleephub
# never invokes it, and retaining a network daemon with its own Go dependency
# graph would expand both the runtime surface and vulnerability inventory.
RUN rm -f /usr/bin/pebble && \
    chmod 0755 /usr/local/bin/bleephub-pages-jekyll && \
    useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin bleephub
WORKDIR /
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
    CMD bash -c "exec 3<>/dev/tcp/127.0.0.1/5555 && printf 'GET /health HTTP/1.0\r\n\r\n' >&3 && grep -q '^HTTP/1.[01] 200' <&3"
ENTRYPOINT ["bleephub"]
