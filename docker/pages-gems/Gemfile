# The gem tree the release image installs to run GitHub Pages builds. Every gem
# in the resolved closure is pinned by SHA-256 in pinned-gems.sha256, which the
# image downloads and verifies before bundler installs anything (--local).
#
# This mirrors the github-pages 232 gem set exactly, EXCEPT jekyll-remote-theme
# is carried at 0.5.2 rather than the metagem's 0.4.3 pin: 0.4.3 caps rubyzip at
# < 3.0 (CVE-2026-85396, fixed only in rubyzip >= 3.4.0), while 0.5.2 allows
# rubyzip < 4.0 and keeps jekyll < 5.0 (so Jekyll stays 3.10.0). The github-pages
# metagem itself is dropped because its exact 0.4.3 pin cannot coexist with 0.5.2;
# its plugins are listed here directly. Regenerate both files with resolve-pins.py.
source "https://rubygems.org"

# Jekyll and the libraries it and the plugins build on.
gem "jekyll", "= 3.10.0"
gem "github-pages-health-check", "= 1.18.2"
gem "jekyll-sass-converter", "= 1.5.2"
gem "kramdown", "= 2.4.0"
gem "kramdown-parser-gfm", "= 1.1.0"
gem "liquid", "= 4.0.4"
gem "mercenary"
gem "nokogiri"
gem "rouge", "= 3.30.0"
gem "terminal-table"
gem "webrick"

# GitHub Pages' bundled themes, selected through a site's `theme:` setting.
gem "jekyll-swiss", "= 1.0.0"
gem "jekyll-theme-architect", "= 0.2.0"
gem "jekyll-theme-cayman", "= 0.2.0"
gem "jekyll-theme-dinky", "= 0.2.0"
gem "jekyll-theme-hacker", "= 0.2.0"
gem "jekyll-theme-leap-day", "= 0.2.0"
gem "jekyll-theme-merlot", "= 0.2.0"
gem "jekyll-theme-midnight", "= 0.2.0"
gem "jekyll-theme-minimal", "= 0.2.0"
gem "jekyll-theme-modernist", "= 0.2.0"
gem "jekyll-theme-primer", "= 0.6.0"
gem "jekyll-theme-slate", "= 0.2.0"
gem "jekyll-theme-tactile", "= 0.2.0"
gem "jekyll-theme-time-machine", "= 0.2.0"
gem "minima", "= 2.5.1"

# GitHub Pages' plugins, auto-loaded even under `jekyll build --safe`.
group :jekyll_plugins do
  gem "jekyll-avatar", "= 0.8.0"
  gem "jekyll-coffeescript", "= 1.2.2"
  gem "jekyll-commonmark-ghpages", "= 0.5.1"
  gem "jekyll-default-layout", "= 0.1.5"
  gem "jekyll-feed", "= 0.17.0"
  gem "jekyll-gist", "= 1.5.0"
  gem "jekyll-github-metadata", "= 2.16.1"
  gem "jekyll-include-cache", "= 0.2.1"
  gem "jekyll-mentions", "= 1.6.0"
  gem "jekyll-optional-front-matter", "= 0.3.2"
  gem "jekyll-paginate", "= 1.1.0"
  gem "jekyll-readme-index", "= 0.3.0"
  gem "jekyll-redirect-from", "= 0.16.0"
  gem "jekyll-relative-links", "= 0.6.1"
  gem "jekyll-remote-theme", "= 0.5.2"
  gem "jekyll-seo-tag", "= 2.8.0"
  gem "jekyll-sitemap", "= 1.4.0"
  gem "jekyll-titles-from-headings", "= 0.5.3"
  gem "jemoji", "= 0.13.0"
end
